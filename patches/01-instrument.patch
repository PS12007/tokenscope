@@ -1642,6 +1643,11 @@ static bool needs_raw_logits(const llama_ubatch & ubatch, const std::map<llama_s
 }
 
 int llama_context::decode(const llama_batch & batch_inp) {
+    // tokenscope: draw the prefill/decode boundary explicitly here, rather than
+    // inheriting the n_queued_tokens heuristic in synchronize(). RAII so that
+    // every early return below still closes the slice.
+    TS_TOKEN_SCOPE(batch_inp.n_tokens > 1, (uint32_t) batch_inp.n_tokens);
+
     // MTP hook batches carry both token (next-token id) and embd (h_nextn row),
     // so accept either present rather than requiring exactly one.
     GGML_ASSERT(batch_inp.token || batch_inp.embd);
